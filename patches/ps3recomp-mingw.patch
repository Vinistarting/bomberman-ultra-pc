 static u8 pad_sdl_axis_to_u8(int raw)
 {
-    /* SDL axis: -32768..32767 -> 0..255 with center at 128 */
+    /* SDL axis: -32768..32767 -> 0..255 with center at 128, with a radial
+     * deadzone so a resting stick reads exactly 128 (the guest treats 127 as
+     * SELECT|START aliasing on some titles -- see the XInput note). */
+    if (raw > -7849 && raw < 7849) return 128;
     int val = ((raw + 32768) * 255) / 65535;
