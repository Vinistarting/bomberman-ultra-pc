+/* Roda os jobs [jobs, jobs+n) -- independentes entre si, como entre dois SYNC
+ * -- e só volta quando todos acabaram. */
+static void jc_run_group_impl(const u32* jobs, int n, int idx0, u32 size_desc);
+static PPU_THREAD_LOCAL uint32_t s_jc_ft_slot;
+static void jc_run_group(const u32* jobs, int n, int idx0, u32 size_desc)
+{
+    const uint64_t t0 = PS3_FT_ON() ? ps3_ft_now() : 0;
+    jc_run_group_impl(jobs, n, idx0, size_desc);
+    if (t0) ps3_ft_span(18, s_jc_ft_slot, (uint32_t)n, jobs[0], t0, ps3_ft_now());
