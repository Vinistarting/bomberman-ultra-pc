+/* SDL2 backend, driven from the WINDOW thread.
+ *
+ * SDL's joystick layer (HIDAPI for DualShock 4 / DualSense, XInput/WGI/
+ * RawInput for Xbox) expects to be initialised and pumped on the thread that
+ * runs SDL_PumpEvents. The game polls cellPad from its own threads, so the
+ * window thread calls cellPad_host_pump() every pass (src/main.cpp), which
+ * handles hotplug, reads every controller into a snapshot and sends rumble;
+ * pad_poll_sdl2 on the game side only copies the snapshot. A build that never
+ * calls the pump falls back to polling SDL from the game thread as before.
+ *
+ * Ports are handed out in connection order: the first controller is player 1
+ * and so on; a controller that disconnects frees its port, and the next one
+ * plugged in takes the lowest free port. */
+
+static SDL_JoystickID s_sdl_ids[PAD_MAX_HOST_PORTS];
+static PadHostState   s_sdl_snap[PAD_MAX_HOST_PORTS];
+static SDL_SpinLock   s_sdl_lock;
