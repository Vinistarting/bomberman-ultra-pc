+static void pad_sdl_check_quit(unsigned long long now)
+{
+    static unsigned long long since = 0;
+    int held = 0;
+    static u8 prev[PAD_MAX_HOST_PORTS];
+    static int logged = 0;
+    for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) {
+        SDL_GameController* gc = s_sdl_controllers[i];
+        if (!gc) { prev[i] = 0; continue; }
+        const u8 sel = SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_BACK) ? 1 : 0;
+        const u8 sta = SDL_GameControllerGetButton(gc, SDL_CONTROLLER_BUTTON_START) ? 2 : 0;
+        const u8 cur = sel | sta;
