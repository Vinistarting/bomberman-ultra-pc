+/* PS3_VFS_REDIRECT="<nome>=<substituto>[;...]": se o caminho do host
+ * termina em /<nome> e <substituto> existe na mesma pasta, abre o substituto
+ * (port Bomberman: media.zip=media_ptbr.zip para a tradução PT-BR). Vale
+ * para todas as camadas (cellFs e sys_fs), então stat e open concordam. */
+void ps3_vfs_redirect(char* path, size_t cap)
+{
+    static const char* spec = NULL; static int init = 0;
+    if (!init) { spec = getenv("PS3_VFS_REDIRECT"); init = 1; }
+    if (!spec || !*spec || !path) return;
+    const size_t plen = strlen(path);
+    const char* p = spec;
+    while (*p) {
+        const char* eq = strchr(p, '=');
+        if (!eq) return;
+        const char* end = strchr(eq + 1, ';');
+        if (!end) end = eq + strlen(eq);
+        const size_t nlen = (size_t)(eq - p), slen = (size_t)(end - eq - 1);
+        if (nlen && slen && plen > nlen && strncmp(path + plen - nlen, p, nlen) == 0 &&
+            (path[plen - nlen - 1] == '/' || path[plen - nlen - 1] == '\\')) {
+            char alt[1200];
+            const size_t dir = plen - nlen;
+            if (dir + slen + 1 <= sizeof alt) {
+                memcpy(alt, path, dir); memcpy(alt + dir, eq + 1, slen); alt[dir + slen] = 0;
+                struct stat st;
+                if (stat(alt, &st) == 0 && strlen(alt) + 1 <= cap) {
+                    static int logged = 0;
+                    if (!logged++) fprintf(stderr, "[vfs] redirecionado: %s -> %s\n", path, alt);
+                    strcpy(path, alt);
+                }
+            }
+            return;
+        }
+        p = *end ? end + 1 : end;
+    }
+}
