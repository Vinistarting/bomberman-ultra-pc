+static void jc_run_group_impl(const u32* jobs, int n, int idx0, u32 size_desc)
+{
+    if (n <= 0) return;
+    if (n == 1 || !TryAcquireSRWLockExclusive(&s_jp.lock)) {
+        for (int i = 0; i < n; i++) jc_run_one_job(jobs[i], idx0 + i, size_desc);
+        return;
+    }
+    if (jc_pool_threads() == 0) {
+        ReleaseSRWLockExclusive(&s_jp.lock);
+        for (int i = 0; i < n; i++) jc_run_one_job(jobs[i], idx0 + i, size_desc);
+        return;
+    }
