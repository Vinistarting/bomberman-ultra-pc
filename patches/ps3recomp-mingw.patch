+/* ---------------------------------------------------------------------------
+ * Jobs em paralelo (port Bomberman)
+ *
+ * No PS3 os JOBs de uma cadeia entre dois SYNC rodam em paralelo nos SPUs do
+ * SPURS (5-6). O walker os rodava um por um numa só thread host, e o PPU fica
+ * parado em JoinJobChain esperando: no Bomberman isso era ~80% do tempo do
+ * frame. Aqui cada grupo de JOBs consecutivos vai para um pool de threads
+ * (cada uma com o seu número de SPU, como pede spurs_job_set_spu_num), e as
+ * conclusões são sinalizadas em ordem depois que o grupo inteiro termina.
+ * PS3_JC_THREADS=1 volta ao modo serial.
+ * -------------------------------------------------------------------------*/
+extern void spurs_job_set_spu_num(uint32_t n);
+/* Até 11 workers + o walker: o Bomberman roda ~100 jobs de render por frame,
+ * mais que os 6 SPUs do PS3 dariam conta no tempo do PC. O número de SPU
+ * visto pelo job continua em 0..5 (módulo 6). */
+#define JC_POOL_MAX   11
+#define JC_BATCH_MAX  64
+static struct {
+    SRWLOCK            lock;        /* um grupo por vez usa o pool */
+    SRWLOCK            cv_lock;
+    CONDITION_VARIABLE cv;
+    volatile LONG      gen;         /* incrementa a cada grupo publicado */
+    volatile LONG      open;        /* grupo aceitando workers (sob cv_lock) */
+    volatile LONG      active;      /* workers dentro de jc_pool_drain */
+    volatile LONG      next, done, total;
+    u32                jobs[JC_BATCH_MAX];
+    int                idx0;
+    u32                size_desc;
+    int                nthreads;    /* workers além da thread do walker */
+    int                started;
+} s_jp;
+
+static void jc_pool_drain(void)
+{
+    for (;;) {
+        const LONG k = InterlockedIncrement(&s_jp.next) - 1;
+        if (k >= s_jp.total) break;
+        jc_run_one_job(s_jp.jobs[k], s_jp.idx0 + (int)k, s_jp.size_desc);
+        InterlockedIncrement(&s_jp.done);
+    }
+}
+
+static DWORD WINAPI jc_pool_worker(LPVOID p)
+{
+    spurs_job_set_spu_num((uint32_t)(intptr_t)p % 6u);
+    LONG seen = 0;
+    for (;;) {
+        AcquireSRWLockExclusive(&s_jp.cv_lock);
+        while (!(s_jp.open && s_jp.gen != seen))
+            SleepConditionVariableSRW(&s_jp.cv, &s_jp.cv_lock, INFINITE, 0);
+        seen = s_jp.gen;
+        InterlockedIncrement(&s_jp.active);     /* só entra com o grupo aberto */
+        ReleaseSRWLockExclusive(&s_jp.cv_lock);
+        jc_pool_drain();
+        InterlockedDecrement(&s_jp.active);
+    }
+    return 0;
+}
+
+static int jc_pool_threads(void)
+{
+    if (s_jp.started) return s_jp.nthreads;
+    /* primeira chamada vem de uma thread de cadeia; corrida benigna evitada
+     * pelo lock do grupo, tomado antes daqui */
+    s_jp.started = 1;
+    int n = -1;
+    const char* e = getenv("PS3_JC_THREADS");
+    if (e && *e) n = atoi(e) - 1;
+    if (n < 0) {
+        SYSTEM_INFO si; GetSystemInfo(&si);
+        n = (int)si.dwNumberOfProcessors - 2;   /* deixa núcleo p/ PPU, RSX, áudio */
+    }
+    if (n > JC_POOL_MAX) n = JC_POOL_MAX;
+    if (n < 0) n = 0;
+    InitializeSRWLock(&s_jp.cv_lock);
+    InitializeConditionVariable(&s_jp.cv);
+    int made = 0;
+    for (int i = 0; i < n; i++) {
+        HANDLE th = CreateThread(NULL, 1u << 20, jc_pool_worker, (LPVOID)(intptr_t)(i + 1), 0, NULL);
+        if (!th) break;
+        CloseHandle(th);
+        made++;
+    }
+    s_jp.nthreads = made;
+    printf("[cellSpurs] job chains: %d worker thread(s) + walker run each job group in parallel\n", made);
+    return made;
+}
