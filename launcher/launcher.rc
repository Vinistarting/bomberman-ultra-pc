#include <windows.h>
#include "resource.h"

IDI_APP ICON "bomberman.ico"
1 RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "FileDescription", "Bomberman ULTRA - Launcher (port PC)"
      VALUE "ProductName", "Bomberman ULTRA PC Port"
      VALUE "FileVersion", "0.1.0"
      VALUE "OriginalFilename", "BombermanUltraLauncher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
